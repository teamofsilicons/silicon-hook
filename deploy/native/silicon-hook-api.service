[Unit]
Description=Silicon Hook API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=silicon-hook
Group=silicon-hook
WorkingDirectory=/opt/silicon-hook/current
EnvironmentFile=/etc/silicon-hook/api.env
ExecStart=/opt/silicon-hook/current/bin/hook-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
