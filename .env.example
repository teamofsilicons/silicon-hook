HOOK_ENVIRONMENT=development
HOOK_LOG_FILTER=silicon_hook=debug,tower_http=info

# API and worker runtime database connection (use separate credentials in production).
HOOK_DATABASE_URL=postgres://silicon_hook:silicon_hook@127.0.0.1:5432/silicon_hook
HOOK_DATABASE_MAX_CONNECTIONS=16
HOOK_SHUTDOWN_TIMEOUT_SECONDS=30

# hook-api only.
HOOK_BIND_ADDR=127.0.0.1:8080
HOOK_PUBLIC_BASE_URL=http://localhost:8080

# Generate 32 random bytes and encode them as base64url without padding.
# Multiple decrypt-only versions use "1:<key>,2:<key>" and the current version
# selects the key used for new or rotated hook secrets.
HOOK_ENCRYPTION_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
HOOK_ENCRYPTION_CURRENT_VERSION=1
HOOK_CURSOR_SIGNING_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE

HOOK_IAM_BASE_URL=http://localhost:8081
HOOK_IAM_APP_ID=silicon-hook
HOOK_IAM_APP_SECRET=development-only-change-me
HOOK_ALLOW_LOCAL_AUTH=true
HOOK_LOCAL_IAM_SERVICE_TOKEN=development-iam-service-token

HOOK_REQUEST_TIMEOUT_SECONDS=15
# These three public-contract values are fixed and must match exactly.
HOOK_MAX_INGRESS_BODY_BYTES=1048576
HOOK_MAX_MANAGEMENT_BODY_BYTES=65536
HOOK_SIGNATURE_TOLERANCE_SECONDS=300
HOOK_IDEMPOTENCY_TTL_SECONDS=86400
HOOK_SECRET_REPLAY_TTL_SECONDS=600
HOOK_DELETION_RETENTION_SECONDS=3888000

# hook-worker only.
HOOK_DM_BASE_URL=http://localhost:8082/api/v1
HOOK_DM_SERVICE_TOKEN=development-hook-service-token
HOOK_DM_REQUEST_TIMEOUT_SECONDS=10
HOOK_DM_MAX_REQUEST_BYTES=1052672

HOOK_WORKER_BATCH_SIZE=100
HOOK_WORKER_DELIVERY_CONCURRENCY=16
HOOK_WORKER_POLL_INTERVAL_MS=500
HOOK_WORKER_LEASE_SECONDS=60
HOOK_WORKER_MAX_ATTEMPTS=20
HOOK_WORKER_MAX_RETRY_DELAY_SECONDS=900
HOOK_MAINTENANCE_BATCH_SIZE=1000
HOOK_MAINTENANCE_BATCHES_PER_CYCLE=32
HOOK_MAINTENANCE_INTERVAL_SECONDS=5

# hook-migrate only.
HOOK_MIGRATOR_DATABASE_URL=postgres://silicon_hook:silicon_hook@127.0.0.1:5432/silicon_hook
