HOOK_ENVIRONMENT=development
HOOK_LOG_FILTER=silicon_hook=debug,tower_http=info

# API and worker runtime database connection (use separate credentials in production).
HOOK_DATABASE_URL=postgres://silicon_hook:silicon_hook@127.0.0.1:5432/silicon_hook
HOOK_DATABASE_MAX_CONNECTIONS=16
HOOK_SHUTDOWN_TIMEOUT_SECONDS=30

# hook-api only.
HOOK_BIND_ADDR=127.0.0.1:8080
HOOK_PUBLIC_BASE_URL=http://localhost:8080
# Number of reverse proxies in front of Hook that append X-Forwarded-For.
# 0 trusts the TCP peer address; behind one load balancer use 1.
HOOK_TRUSTED_PROXY_HOPS=0

# Generate 32 random bytes and encode them as base64url without padding.
# Multiple decrypt-only versions use "1:<key>,2:<key>" and the current version
# selects the key used for new or rotated hook secrets.
HOOK_ENCRYPTION_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
HOOK_ENCRYPTION_CURRENT_VERSION=1
HOOK_CURSOR_SIGNING_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE

# Silicon IAM. Hook is an IAM Application: HOOK_IAM_APP_ID and the ask_ secret
# come from registering it with IAM. Production requires HTTPS and forbids both
# local authentication and plain HTTP.
HOOK_IAM_BASE_URL=http://127.0.0.1:8081
HOOK_IAM_ALLOW_INSECURE_LOCAL_HTTP=true
# HOOK_IAM_APP_ID=tos>hook
# HOOK_IAM_APP_SECRET=ask_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Deterministic local:<carbon|silicon>:<member|admin|owner>:<id> bearers; no IAM needed.
HOOK_ALLOW_LOCAL_AUTH=true
# Hook's Application webhook secret (whs_) and its version, for /webhook/.
# HOOK_IAM_WEBHOOK_SECRET=whs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HOOK_IAM_WEBHOOK_SECRET_VERSION=1
# HOOK_IAM_WEBHOOK_PREVIOUS_SECRET=
# HOOK_IAM_WEBHOOK_PREVIOUS_SECRET_VERSION=

HOOK_REQUEST_TIMEOUT_SECONDS=15
# These public-contract values are fixed and must match exactly.
HOOK_MAX_INGRESS_BODY_BYTES=1048576
HOOK_MAX_MANAGEMENT_BODY_BYTES=65536
HOOK_IDEMPOTENCY_TTL_SECONDS=86400
HOOK_SECRET_REPLAY_TTL_SECONDS=600
HOOK_DELETION_RETENTION_SECONDS=3888000
HOOK_LOG_RETENTION_SECONDS=1209600
HOOK_REALTIME_HEARTBEAT_INTERVAL_SECONDS=30
HOOK_REALTIME_HEARTBEAT_TIMEOUT_SECONDS=120
# Tunable realtime delivery capacity.
HOOK_REALTIME_REPLAY_BATCH_SIZE=100
HOOK_REALTIME_POLL_INTERVAL_MS=1000
HOOK_REALTIME_MAX_SILICONS_PER_CONNECTION=64

# hook-worker only.
HOOK_MAINTENANCE_BATCH_SIZE=1000
HOOK_MAINTENANCE_BATCHES_PER_CYCLE=32
HOOK_MAINTENANCE_INTERVAL_SECONDS=5

# hook-migrate only.
HOOK_MIGRATOR_DATABASE_URL=postgres://silicon_hook:silicon_hook@127.0.0.1:5432/silicon_hook

# Testing requires a separate database. Apply migrations and runtime grants to both.
# HOOK_TEST_DATABASE_URL=postgres://silicon_hook_api:password@127.0.0.1:5432/hook_test
# HOOK_TEST_MIGRATOR_DATABASE_URL=postgres://migrator:password@127.0.0.1:5432/hook_test
