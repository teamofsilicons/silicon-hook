HOOK_ENVIRONMENT=development
HOOK_LOG_FILTER=silicon_hook=debug,tower_http=info

# API and worker runtime database connection (use separate credentials in production).
HOOK_DATABASE_URL=postgres://silicon_hook:silicon_hook@127.0.0.1:5432/silicon_hook
HOOK_DATABASE_MAX_CONNECTIONS=16
HOOK_SHUTDOWN_TIMEOUT_SECONDS=30

# hook-api only.
HOOK_BIND_ADDR=127.0.0.1:8080
HOOK_PUBLIC_BASE_URL=http://localhost:8080
# Number of reverse proxies in front of Hook that append X-Forwarded-For.
# 0 trusts the TCP peer address; behind one load balancer use 1.
HOOK_TRUSTED_PROXY_HOPS=0

# Generate 32 random bytes and encode them as base64url without padding.
# Multiple decrypt-only versions use "1:<key>,2:<key>" and the current version
# selects the key used for new or rotated hook secrets.
HOOK_ENCRYPTION_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
HOOK_ENCRYPTION_CURRENT_VERSION=1
HOOK_CURSOR_SIGNING_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE

# Silicon Accounts. Hook signs Carbons and Silicons in with Silicon Accounts and
# accepts only access tokens issued to HOOK_APP_ID. ACCOUNTS_URL is the public URL
# (the token issuer); ACCOUNTS_API_URL optionally reaches the same service on a
# private address. Plain http is accepted for loopback hosts outside production.
# Local stack: ACCOUNTS_URL=http://localhost:9590 and ACCOUNTS_API_URL=http://127.0.0.1:9589.
ACCOUNTS_URL=https://accounts.teamofsilicons.com
# ACCOUNTS_API_URL=
HOOK_APP_ID=hook
# Hook's app secret (sa_app_...), from Hook's sign-in setup in Silicon Accounts.
HOOK_APP_SECRET=sa_app_replace-with-hooks-app-secret
# Signing secret of Hook's Silicon Accounts webhook (POST /webhook). Required in
# production. During a rotation, put the old one in ..._PREVIOUS_SECRET.
# HOOK_ACCOUNTS_WEBHOOK_SECRET=whsec_...
# HOOK_ACCOUNTS_WEBHOOK_PREVIOUS_SECRET=
# Deadline for one call to Silicon Accounts (1 to 30 seconds).
HOOK_ACCOUNTS_TIMEOUT_SECONDS=5

HOOK_REQUEST_TIMEOUT_SECONDS=15
# These public-contract values are fixed and must match exactly.
HOOK_MAX_INGRESS_BODY_BYTES=1048576
HOOK_MAX_MANAGEMENT_BODY_BYTES=65536
HOOK_IDEMPOTENCY_TTL_SECONDS=86400
HOOK_SECRET_REPLAY_TTL_SECONDS=600
HOOK_DELETION_RETENTION_SECONDS=3888000
HOOK_LOG_RETENTION_SECONDS=1209600

# Delivery through Ting. Leave HOOK_TING_URL unset to turn delivery off: Hook
# still receives, verifies and stores every event, queues nothing, and says so in
# its logs, /readyz and the delivery routes. Plain http only for loopback hosts.
# HOOK_TING_URL=https://backend.ting.teamofsilicons.com/
HOOK_TING_TIMEOUT_SECONDS=10
HOOK_TING_POLL_MILLISECONDS=1000

# hook-worker only.
HOOK_MAINTENANCE_BATCH_SIZE=1000
HOOK_MAINTENANCE_BATCHES_PER_CYCLE=32
HOOK_MAINTENANCE_INTERVAL_SECONDS=5

# hook-migrate only.
HOOK_MIGRATOR_DATABASE_URL=postgres://silicon_hook:silicon_hook@127.0.0.1:5432/silicon_hook

# Diagnostic telemetry is on by default; off suppresses collection and export.
HOOK_TELEMETRY=on
# Hook-only Space Station write key; keep it on worker hosts, never in the browser.
# HOOK_TELEMETRY_TABLE_KEY=table-siliconhook-<32 hex>
# HOOK_TELEMETRY_SPOOL_DIR=/var/lib/silicon-hook/telemetry
